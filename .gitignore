# Git Ignore for Polyglot AI Summarizer

# Node.js / Next.js
# ===============================
# node_modules
# Directory for npm packages
node_modules/

# Next.js build output
.next/
out/

# Local environment variables
# These should not be committed to version control.
# A .env.example file is provided for reference.
.env
.env.local
.env.development.local
.env.production.local

# npm-debug.log* files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml # If pnpm is used

# TypeScript build output
# Generated by Next.js, typically not committed
next-env.d.ts

# Logs
*.log

# Python
# ===============================
# Byte-code files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
# Directory for Python virtual environments
venv/
.venv/
env/

# Distribution / build files
dist/
build/
*.egg-info/

# Logs and temporary files
pip-log.txt
pip-delete-this-directory.txt

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# IDE specific files (e.g., for PyCharm)
.idea/

# General
# ===============================
# Operating System files
.DS_Store # macOS
Thumbs.db # Windows

# Editor/IDE specific files
.vscode/ # VS Code settings (can be useful to share some, but often ignored)

# Sensitive files (if generated)
*.pem
*.key

# Database files (if local SQLite or similar is used)
*.sqlite
*.db

# Uploaded files or generated content (if applicable)
# For example, if summaries were saved locally
# uploads/
# generated_summaries/