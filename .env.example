# .env.example

# This file contains example environment variables for the Polyglot AI Summarizer application.
# Copy this file to `.env` and fill in your actual values.
# Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.

# --- Frontend (Next.js) Configuration ---
# The base URL for the Python backend API.
# Ensure this matches the address where your backend service is running.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api/v1

# --- Backend (Python FastAPI) Configuration ---
# The port on which the FastAPI backend server will listen.
BACKEND_PORT=8000

# --- NLP Service Provider Configuration ---
# Specify the Natural Language Processing (NLP) service provider to use.
# The `backend/nlp_service.py` module will use this to initialize the correct client.
# Supported values might include: "openai", "huggingface", "google_cloud", "local"
NLP_SERVICE_PROVIDER=openai

# API Key for the chosen NLP service provider.
# If using OpenAI:
OPENAI_API_KEY=sk-your_openai_api_key_here

# If using Hugging Face Inference API:
# HUGGINGFACE_API_KEY=hf_your_huggingface_api_token_here

# If using Google Cloud services (e.g., for Translation API):
# GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-file.json

# Base URL for the NLP service API, if different from the default or for self-hosted models.
# For OpenAI, this is typically not needed unless using a proxy or custom endpoint.
# NLP_BASE_URL=https://api.openai.com/v1

# --- Model Configuration ---
# Specify the models to be used for summarization and translation tasks.
# These should correspond to models available from your chosen NLP_SERVICE_PROVIDER.
# Examples for OpenAI: "gpt-3.5-turbo-instruct", "gpt-4", "text-davinci-003"
# Examples for Hugging Face: "facebook/bart-large-cnn" (summarization), "Helsinki-NLP/opus-mt-en-fr" (translation)
SUMMARIZATION_MODEL=gpt-3.5-turbo-instruct
TRANSLATION_MODEL=gpt-3.5-turbo-instruct # Or a dedicated translation model if available and preferred

# --- Summarization Parameters ---
# Default minimum and maximum token lengths for generated summaries.
# These can often be overridden by client requests to the API.
DEFAULT_MIN_SUMMARY_TOKENS=50
DEFAULT_MAX_SUMMARY_TOKENS=200

# --- Logging Configuration ---
# Set the logging level for the backend application.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Security Configuration (Optional but Recommended for Production) ---
# A secret key used for various security purposes, e.g., signing tokens, session management.
# Generate a strong, random string for this in production.
# Example: openssl rand -hex 32
# SECRET_KEY=your_super_secret_random_key_here
```